  "acceptance_criteria": [
    {
      "id": "AC-01",
      "requirement": "Foundation approval binds destination, source, policies and files; inactive or stale approval refuses dispatch.",
      "evidence": [
        "Positive package validation and exact fingerprint",
        "Inactive, forged, altered-file, altered-policy and changed-anchor refusals",
        "Owner receipt only after explicit later approval"
      ],
      "status": "pending"
    },
    {
      "id": "AC-02",
      "requirement": "Retain Docker read/write/network isolation for worker and acceptance exports.",
      "evidence": [
        "Denied host/sibling/Git/socket/credential/link/network access and immutable writes",
        "Allowed scoped task succeeds",
        "Image ID and Docker inspect evidence for both worker and acceptance"
      ],
      "status": "pending"
    },
    {
      "id": "AC-03",
      "requirement": "Only one branch/workspace owner and one consumed start survive failure, races and recovery.",
      "evidence": [
        "Startup refusal plus failed logging cannot reuse token",
        "Concurrent execute permits at most one Docker start",
        "Restart after consumed-start commit refuses retry",
        "Expiry recovery requires stopped tree and preserved output; old token refused"
      ],
      "status": "pending"
    },
    {
      "id": "AC-04",
      "requirement": "Routing preserves role/risk/complexity floors, eligibility, expected-cost ranking and context bounds.",
      "evidence": [
        "Source routing tests ported with disabled resources",
        "Risk/tier/provider-unavailable/context-negative cases",
        "Decision replay reproduces selected resource and reasons from saved config"
      ],
      "status": "pending"
    },
    {
      "id": "AC-05",
      "requirement": "Attempts, repeated failures, repairs, resumptions and review caps remain cumulative and bounded.",
      "evidence": [
        "Worker cap 2 and reviewer cap 2; tier caps and deadlines enforced",
        "Contract repair/resume/resubmission never reset counts",
        "Repeated worker and reviewer fingerprints escalate or hold; exhausted budgets refuse"
      ],
      "status": "pending"
    },
    {
      "id": "AC-06",
      "requirement": "Budget accounting retains settled spend and pending liability and refuses unknown metered cost.",
      "evidence": [
        "Concurrent reservations fit task/role/project caps",
        "Missing/zero/positive unmeasured cost remains held; measured cache usage priced conservatively",
        "Abandoned possibly charged run never becomes free",
        "Zero budgets and disabled resources prevent live API calls"
      ],
      "status": "pending"
    },
    {
      "id": "AC-07",
      "requirement": "Dispatch and ingestion bind one reservation to the exact scoped run and report.",
      "evidence": [
        "Duplicate reservation/start/RESULT and changed brief/binding/deadline refusals",
        "Wrong dispatch/check IDs/types/oversized report/path escape/link/stale bundle refusals",
        "Crash between reserve/render/claim/start/result reconciles without implicit launch"
      ],
      "status": "pending"
    },
    {
      "id": "AC-08",
      "requirement": "Independent acceptance checks the current candidate and preserves source gate floors.",
      "evidence": [
        "Worker PASS cannot accept; same actor and reviewer-tier/family shortfalls refused",
        "Fresh isolated deterministic checks bound to candidate/image",
        "Changed artifact/reference/commit/interface invalidates earlier gates",
        "Hardware evidence missing means unverified; feedback sync is bound and idempotent"
      ],
      "status": "pending"
    },
    {
      "id": "AC-09",
      "requirement": "One canonical durable journal survives Windows interruption across all repository worktrees.",
      "evidence": [
        "Thread/process append collision and actual process-kill/restart tests",
        "Alternate-state, gap, digest mismatch and stale stream-head refusals",
        "One-time source chain import retains IDs/head/counts/spend",
        "Backup/restore verifies journal and referenced evidence before dispatch"
      ],
      "status": "pending"
    },
    {
      "id": "AC-10",
      "requirement": "A fresh session resumes from bounded coordinator/worker handoffs without widening scope.",
      "evidence": [
        "Clean-start and interrupted-run resume identify objective/scope/base/diff/interface/pending spend/blocker/next action",
        "Stale derived view refused; exact missing-context proposal yields smallest revised scope",
        "UTC timestamps and measured/estimated/unknown context usage accurately labeled"
      ],
      "status": "pending"
    },
    {
      "id": "AC-11",
      "requirement": "Acceptance, integration and deployment remain distinct; interfaces and live required checks gate promotion.",
      "evidence": [
        "Exact feature/UI/base candidate identities and contract/boundary tests",
        "Approved interface change links UI and mocks; internal-only change requires no UI work",
        "Changed head invalidates checks; missing/failing live required checks block promotion",
        "No deployment or hardware success inferred from tests"
      ],
      "status": "pending"
    },
    {
      "id": "AC-12",
      "requirement": "Closeout preserves original/source work and every permanent feature branch locally and on origin.",
      "evidence": [
        "No donor cleanup/delete/reset/force-push/rename path imported",
        "Before authorized merge verify delete_branch_on_merge=false and exact reviewed head",
        "Two successive releases from retained branch preserve history and avoid duplicate changes",
        "Protected statuses/indexes and unrelated branch refs preserved"
      ],
      "status": "pending"
    }
  ],
  "blockers": [
    "Launch prerequisite: durably consume startup authority; retry/race/restart defect remains unrepaired.",
    "Rollout prerequisite: implement journal, controllers, Docker dispatch and independent acceptance adapters in milestone order.",
    "Acceptance prerequisite: independent exact-candidate and Windows crash/concurrency evidence; historical tests are insufficient.",
    "Outside scope: real model resources, prices, provider-only egress, credentials, paid-worker authority and Git publication require a new owner-reviewed proposal."
  ],
