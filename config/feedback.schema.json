{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded feedback policy, result, and diagnosis",
  "description": "Canonical shapes for local feedback-controller records. Examples and evidence are source assertions only. Runtime adds finite-number checks, contract/check references, repeated-failure rules, and dispatch/architecture bindings. These files do not configure or call models.",
  "$ref": "#/$defs/destination_policy",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/bounded_text"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "max_attempts_by_tier",
        "repeated_failure_per_tier",
        "repeated_failure_total",
        "max_contract_repairs",
        "max_blocker_resumptions",
        "max_architect_diagnoses",
        "max_context_chars",
        "max_history_entries",
        "attempt_timeout_seconds"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "max_attempts_by_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "1",
            "2",
            "3",
            "4"
          ],
          "properties": {
            "0": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "1": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "2": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "3": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "4": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        "repeated_failure_per_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "repeated_failure_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_contract_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_blocker_resumptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_architect_diagnoses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "max_history_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "attempt_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "description": "Bounded feedback-controller policy. Limits constrain local control flow; they do not authorize execution or establish that a model or external system was called."
    },
    "validation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "passed",
        "failure_code",
        "expected",
        "actual",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/identifier"
        },
        "passed": {
          "type": "boolean"
        },
        "failure_code": {
          "type": "string",
          "maxLength": 200
        },
        "expected": {
          "type": "string",
          "maxLength": 2000
        },
        "actual": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "description": "One reported validation check. Empty failure_code, expected, and actual are structurally allowed; runtime checks failure codes, declared check IDs, and acceptance criteria."
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/bounded_text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "outcome",
        "summary",
        "scope_status",
        "architecture_conflict",
        "validation",
        "evidence",
        "discoveries",
        "api_cost_usd",
        "cost_evidence"
      ],
      "properties": {
        "dispatch_id": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NEEDS_ESCALATION",
            "ARCHITECTURE_CONFLICT",
            "PROVIDER_UNAVAILABLE"
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "scope_status": {
          "type": "string",
          "enum": [
            "within",
            "violated",
            "unknown"
          ]
        },
        "architecture_conflict": {
          "type": "boolean"
        },
        "validation": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/validation_check"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "discoveries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/discovery"
          }
        },
        "api_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000,
          "description": "Reported API spend in USD. null means unknown (an abandoned attempt with no accounting); it is never read as zero."
        },
        "cost_evidence": {
          "$ref": "#/$defs/bounded_text"
        }
      },
      "description": "Bounded result metadata and source assertions, not independent proof of successful work, costs, authorization, or model calls. Runtime verifies dispatch binding and result semantics."
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "reason",
        "evidence",
        "architecture_fingerprint",
        "revised_contract"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "REPAIR_CONTRACT",
            "RESUME_WORK",
            "ARCHITECTURE_CHANGE",
            "BLOCKED"
          ]
        },
        "reason": {
          "$ref": "#/$defs/summary"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "architecture_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "revised_contract": {
          "type": [
            "object",
            "null"
          ],
          "description": "Opaque replacement work contract or null. Runtime validates any object against the canonical work-packet contract and enforces classification-dependent requirements; this field does not grant architecture approval."
        },
        "resolved_providers": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "description": "Optional explicit provider recoveries for RESUME_WORK only; original unavailable receipts remain in the event ledger."
        }
      },
      "description": "Architect diagnosis metadata. Runtime binds the architecture fingerprint and checks classification dependencies; no human authentication or execution authority is implied."
    },
    "review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "verdict",
        "reviewer",
        "summary",
        "evidence",
        "contract_failures",
        "acceptance_reference",
        "binding",
        "result_dispatch_id"
      ],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/sha256"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REJECT_BOUNDED",
            "NEEDS_EVIDENCE",
            "NEEDS_ESCALATION",
            "ARCHITECTURE_CONFLICT"
          ]
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "model_family",
            "tier"
          ],
          "properties": {
            "actor": {
              "$ref": "#/$defs/bounded_text"
            },
            "model_family": {
              "$ref": "#/$defs/bounded_text"
            },
            "tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "contract_failures": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "failed_ref",
              "kind",
              "what_failed",
              "corrective_action"
            ],
            "properties": {
              "failed_ref": {
                "$ref": "#/$defs/bounded_text"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "criterion",
                  "validation",
                  "scope"
                ]
              },
              "what_failed": {
                "$ref": "#/$defs/bounded_text"
              },
              "corrective_action": {
                "$ref": "#/$defs/bounded_text"
              }
            }
          }
        },
        "acceptance_reference": {
          "$ref": "#/$defs/bounded_text"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id",
            "revision",
            "contract_hash"
          ],
          "properties": {
            "task_id": {
              "$ref": "#/$defs/identifier"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "contract_hash": {
              "$ref": "#/$defs/sha256"
            }
          },
          "description": "The task, revision and contract hash the acceptance ledger reviewed. Runtime refuses a decision whose binding differs from this ledger's packet."
        },
        "result_dispatch_id": {
          "$ref": "#/$defs/sha256",
          "description": "dispatch_id of the worker result the acceptance ledger reviewed; must equal the result of the attempt awaiting review here."
        }
      },
      "description": "Condensed independent acceptance decision recorded into the task ledger. The gate evidence lives in the acceptance ledger it references; reviewer identity is a recorded declaration, not authentication. The decision is bound to one task revision and one worker result, so a decision from another task's ledger cannot be recorded here. A bounded rejection's corrective actions are performable inside the current contract only."
    },
    "review_decision_legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "verdict",
        "reviewer",
        "summary",
        "evidence",
        "contract_failures",
        "acceptance_reference"
      ],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/sha256"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REJECT_BOUNDED",
            "NEEDS_EVIDENCE",
            "NEEDS_ESCALATION",
            "ARCHITECTURE_CONFLICT"
          ]
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "model_family",
            "tier"
          ],
          "properties": {
            "actor": {
              "$ref": "#/$defs/bounded_text"
            },
            "model_family": {
              "$ref": "#/$defs/bounded_text"
            },
            "tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "contract_failures": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "failed_ref",
              "kind",
              "what_failed",
              "corrective_action"
            ],
            "properties": {
              "failed_ref": {
                "$ref": "#/$defs/bounded_text"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "criterion",
                  "validation",
                  "scope"
                ]
              },
              "what_failed": {
                "$ref": "#/$defs/bounded_text"
              },
              "corrective_action": {
                "$ref": "#/$defs/bounded_text"
              }
            }
          }
        },
        "acceptance_reference": {
          "$ref": "#/$defs/bounded_text"
        }
      },
      "description": "The pre-binding decision shape, accepted only for REVIEW events already stored in a ledger written before the binding was required. A new REVIEW event must use review_decision."
    },
    "destination_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "max_attempts_by_tier",
        "repeated_failure_per_tier",
        "repeated_failure_total",
        "max_contract_repairs",
        "max_blocker_resumptions",
        "max_architect_diagnoses",
        "max_context_chars",
        "max_history_entries",
        "attempt_timeout_seconds"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "max_attempts_by_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "1",
            "2",
            "3",
            "4"
          ],
          "properties": {
            "0": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "1": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "2": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "3": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "4": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            }
          }
        },
        "repeated_failure_per_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "repeated_failure_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_contract_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "max_blocker_resumptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_architect_diagnoses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 40000
        },
        "max_history_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "attempt_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "description": "Bounded feedback-controller policy. Limits constrain local control flow; they do not authorize execution or establish that a model or external system was called."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "rates_hash",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "evidence_sha256"
      ],
      "properties": {
        "dispatch_id": {
          "$ref": "#/$defs/sha256"
        },
        "rates_hash": {
          "$ref": "#/$defs/sha256"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "destination_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "outcome",
        "summary",
        "scope_status",
        "architecture_conflict",
        "validation",
        "evidence",
        "discoveries",
        "api_cost_usd",
        "cost_evidence"
      ],
      "properties": {
        "dispatch_id": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NEEDS_ESCALATION",
            "ARCHITECTURE_CONFLICT",
            "PROVIDER_UNAVAILABLE"
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "scope_status": {
          "type": "string",
          "enum": [
            "within",
            "violated",
            "unknown"
          ]
        },
        "architecture_conflict": {
          "type": "boolean"
        },
        "validation": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/validation_check"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "discoveries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/discovery"
          }
        },
        "api_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000,
          "description": "Reported API spend in USD. null means unknown (an abandoned attempt with no accounting); it is never read as zero."
        },
        "cost_evidence": {
          "$ref": "#/$defs/bounded_text"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Bounded result metadata and source assertions, not independent proof of successful work, costs, authorization, or model calls. Runtime verifies dispatch binding and result semantics."
    }
  }
}
