[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "@PROJECT_SLUG@"
version = "0.1.0"
description = "Generated headless contract-first OOP worked example"
requires-python = ">=3.12"
dependencies = []

[project.optional-dependencies]
dev = ["pytest>=8", "jsonschema==4.26.0"]

[tool.setuptools.packages.find]
where = ["."]
include = ["contracts*", "src*", "scripts*"]

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]
addopts = "-q"
